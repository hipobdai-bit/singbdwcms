rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Categories - Public read, no write from client
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false; // Only server can write
    }
    
    // Products - Public read, no write from client
    match /products/{productId} {
      allow read: if true;
      allow write: if false; // Only server can write
    }
    
    // Clients - Public read, no write from client
    match /clients/{clientId} {
      allow read: if true;
      allow write: if false; // Only server can write
    }
    
    // Certifications - Public read, no write from client
    match /certifications/{certificationId} {
      allow read: if true;
      allow write: if false; // Only server can write
    }
    
    // Settings - Public read, no write from client
    match /settings/{settingId} {
      allow read: if true;
      allow write: if false; // Only server can write
    }
    
    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
